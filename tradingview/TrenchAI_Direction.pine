//@version=6
// Trench AI Direction
// A self-learning direction predictor. On every candle it:
//   1. learns from the candle whose outcome just became known (online logistic regression),
//   2. predicts whether price will be higher or lower N candles from now,
//   3. keeps an honest scorecard of how often its past calls were right.
// It only ever uses past data - no repainting, no look-ahead.
// Works on any symbol / timeframe. More chart history = more learning.
indicator("Trench AI Direction", shorttitle = "TrenchAI", overlay = false, max_labels_count = 500)

// ───────── Inputs ─────────
horizon  = input.int(1, "Predict this many candles ahead", minval = 1, maxval = 50)
confTh   = input.float(0.58, "Confidence needed for a signal", minval = 0.50, maxval = 0.90, step = 0.01)
lrate    = input.float(0.02, "Learning rate", minval = 0.001, maxval = 0.2, step = 0.005)
l2       = input.float(0.0001, "Regularisation (L2)", minval = 0.0, step = 0.0001)
statLen  = input.int(500, "Scorecard window (candles)", minval = 50, maxval = 5000)
warmup   = input.int(300, "Warm-up candles before scoring", minval = 50)
showArr  = input.bool(true, "Show arrows on price chart")

// ───────── Features (all scaled to roughly -3..+3) ─────────
clip(x) => math.max(-3.0, math.min(3.0, x))

lret  = math.log(close / close[1])
sd    = ta.stdev(lret, 50)
sdOk  = sd > 0 ? sd : na

f1 = clip(lret / sdOk)                                               // last candle move
f2 = clip(math.log(close / close[3]) / (sdOk * math.sqrt(3)))        // 3-candle momentum
f3 = clip(math.log(close / close[12]) / (sdOk * math.sqrt(12)))      // 12-candle momentum
f4 = clip(math.log(close / close[48]) / (sdOk * math.sqrt(48)))      // 48-candle momentum
f5 = clip((ta.rsi(close, 14) - 50) / 25)                             // RSI
f6 = clip(math.log(ta.ema(close, 12) / ta.ema(close, 48)) / (sdOk * 4)) // trend (EMA spread)
hi24 = ta.highest(high, 24)
lo24 = ta.lowest(low, 24)
f7 = hi24 > lo24 ? clip(2 * (close - lo24) / (hi24 - lo24) - 1) : 0.0  // where price sits in its 24-candle range
lv   = math.log(nz(volume) + 1)
lvSd = ta.stdev(lv, 50)
f8 = lvSd > 0 ? clip((lv - ta.sma(lv, 50)) / lvSd) : 0.0             // volume surprise
sd100 = ta.stdev(lret, 100)
f9 = sd100 > 0 ? clip(ta.stdev(lret, 20) / sd100 - 1) : 0.0          // volatility regime

feat(int off) => array.from(f1[off], f2[off], f3[off], f4[off], f5[off], f6[off], f7[off], f8[off], f9[off], 1.0)

hasNa(array<float> a) =>
    bool bad = false
    for v in a
        if na(v)
            bad := true
    bad

sigmoid(float z) => 1.0 / (1.0 + math.exp(-z))

var array<float> w = array.new_float(10, 0.0)

dotW(array<float> x) =>
    float s = 0.0
    for i = 0 to x.size() - 1
        s += x.get(i) * w.get(i)
    s

// ───────── Learn from the candle whose outcome is now known ─────────
xPast = feat(horizon)
var int learned = 0
if bar_index > horizon and not hasNa(xPast) and not na(close[horizon])
    float y = close > close[horizon] ? 1.0 : 0.0
    float p = sigmoid(dotW(xPast))
    for i = 0 to w.size() - 1
        wi = w.get(i)
        w.set(i, wi + lrate * ((y - p) * xPast.get(i) - l2 * wi))
    learned += 1

// ───────── Predict ─────────
xNow  = feat(0)
probUp = hasNa(xNow) ? na : sigmoid(dotW(xNow))
conf   = na(probUp) ? na : math.max(probUp, 1 - probUp)
isUp   = not na(probUp) and probUp >= confTh
isDown = not na(probUp) and probUp <= 1 - confTh

// ───────── Honest scorecard of past predictions ─────────
var array<int> hits     = array.new_int()
var array<int> confHits = array.new_int()
pPrev = probUp[horizon]
if learned > warmup and not na(pPrev) and close != close[horizon]
    int ok = (pPrev > 0.5) == (close > close[horizon]) ? 1 : 0
    hits.push(ok)
    if hits.size() > statLen
        hits.shift()
    if math.max(pPrev, 1 - pPrev) >= confTh
        confHits.push(ok)
        if confHits.size() > statLen
            confHits.shift()

pct(array<int> a) => a.size() > 0 ? 100.0 * a.sum() / a.size() : na

// ───────── Visuals ─────────
upCol   = color.new(#22c55e, 0)
downCol = color.new(#ef4444, 0)
plot(na(probUp) ? na : (probUp - 0.5) * 200, "Edge (+ up / - down)", style = plot.style_columns,
     color = isUp ? upCol : isDown ? downCol : color.new(color.gray, 50))
hline(0, "Neutral", color = color.gray)
hline((confTh - 0.5) * 200, "Signal up", color = color.new(upCol, 40), linestyle = hline.style_dashed)
hline(-(confTh - 0.5) * 200, "Signal down", color = color.new(downCol, 40), linestyle = hline.style_dashed)

plotshape(showArr and isUp and not isUp[1], "Up signal", shape.triangleup, location.belowbar, upCol,
          size = size.small, force_overlay = true)
plotshape(showArr and isDown and not isDown[1], "Down signal", shape.triangledown, location.abovebar, downCol,
          size = size.small, force_overlay = true)

var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(#0f172a, 10), border_width = 1)
if barstate.islast
    sig = isUp ? "▲ UP" : isDown ? "▼ DOWN" : "— NO TRADE"
    sigCol = isUp ? upCol : isDown ? downCol : color.gray
    tb.cell(0, 0, "Trench AI", text_color = color.white, text_size = size.normal)
    tb.cell(1, 0, sig, text_color = sigCol, text_size = size.large)
    tb.cell(0, 1, "Chance of UP", text_color = color.silver)
    tb.cell(1, 1, na(probUp) ? "warming up" : str.tostring(probUp * 100, "#.0") + "%", text_color = color.white)
    tb.cell(0, 2, "Looking ahead", text_color = color.silver)
    tb.cell(1, 2, str.tostring(horizon) + " candle(s)", text_color = color.white)
    tb.cell(0, 3, "Hit rate (all calls)", text_color = color.silver)
    tb.cell(1, 3, str.tostring(pct(hits), "#.0") + "%  (" + str.tostring(hits.size()) + ")", text_color = color.white)
    tb.cell(0, 4, "Hit rate (signals only)", text_color = color.silver)
    tb.cell(1, 4, str.tostring(pct(confHits), "#.0") + "%  (" + str.tostring(confHits.size()) + ")", text_color = color.white)
    tb.cell(0, 5, "Candles learned from", text_color = color.silver)
    tb.cell(1, 5, str.tostring(learned), text_color = color.white)
    tb.cell(0, 6, "Not financial advice. 50% = coin flip.", text_color = color.gray, text_size = size.tiny)
    tb.merge_cells(0, 6, 1, 6)

alertcondition(isUp and not isUp[1], "Trench AI: UP signal", "Trench AI predicts UP on {{ticker}} {{interval}} (price {{close}})")
alertcondition(isDown and not isDown[1], "Trench AI: DOWN signal", "Trench AI predicts DOWN on {{ticker}} {{interval}} (price {{close}})")
